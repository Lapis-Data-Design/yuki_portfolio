{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(npm run typecheck)",
      "Bash(npm test*)"
    ],
    "deny": [
      "Edit(./app/**)",
      "Edit(./lib/**)",
      "Edit(./db/**)",
      "Edit(./tests/**)",
      "Edit(./scripts/**)",
      "Edit(./public/**)",
      "Edit(./.github/**)",
      "Edit(./.claude/**)",
      "Edit(./*.ts)",
      "Edit(./*.tsx)",
      "Edit(./*.js)",
      "Edit(./*.mjs)",
      "Edit(./*.cjs)",
      "Edit(./*.json)",
      "Edit(./.gitignore)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git restore *)",
      "Bash(git stash *)",
      "Bash(git clean *)",
      "Bash(rm *)",
      "Bash(npm install *)",
      "Bash(npm run db:migrate*)",
      "Bash(npm run seed:*)",
      "Bash(npx drizzle-kit *)"
    ]
  }
}
