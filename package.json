{
  "name": "yuki_portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:test": "ENV_FILE=.env.test drizzle-kit migrate",
    "seed:users": "tsx scripts/seed-users.ts",
    "seed:palettes": "tsx scripts/seed-palettes",
    "seed:palettes:test": "ENV_FILE=.env.test tsx scripts/seed-palettes.ts",
    "seed:frames": "tsx scripts/seed-frames.ts",
    "seed:frames:test": "ENV_FILE=.env.test tsx scripts/seed-frames.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:prod": "E2E_TARGET=prod playwright test"
  },
  "dependencies": {
    "@neon/config": "^1.2.0",
    "@neon/env": "^1.2.0",
    "@neondatabase/serverless": "^1.1.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.7"
  }
}
